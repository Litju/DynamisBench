{"analysis_plan":"Aggregate per-replicate canonical jump height, then report the mean and half-range across seeds.","benchmarks":[{"identifier":"db.lcmj20","version":"1.0.0"}],"description":"How sensitive canonical jump height is to contact stiffness.","environments":[{"identifier":"env.mujoco.x86-64","version":"1.0.0"}],"factors":[{"description":"Multiplier applied to the realization's contact stiffness.","distribution":{"kind":"uniform","lower":0.8,"upper":1.2},"factor_id":"f.contact-stiffness","label":"Contact stiffness scale","notes":[],"quantity":"q.foot.vertical_force","role":"factor","target":{"identifier":"rl.mujoco.loaded-cmj","kind":"realization","parameter":"contact-stiffness"}},{"description":"Held at standard gravity for every run in the study.","distribution":{"kind":"point","value":9.80665},"factor_id":"f.gravity","label":"Gravitational acceleration","notes":[],"quantity":"q.jump.height","role":"controlled","target":{"identifier":"rl.mujoco.loaded-cmj","kind":"realization","parameter":"gravity"}}],"label":"Contact stiffness sensitivity","notes":[],"outcomes":["q.jump.height"],"realizations":[{"identifier":"rl.mujoco.loaded-cmj","version":"1.0.0"}],"replicates":3,"required_capabilities":[{"capability":"forward_dynamics","essential":true,"rationale":"forward_dynamics is required by this definition"},{"capability":"state_snapshot","essential":true,"rationale":"state_snapshot is required by this definition"}],"research_question":"How much does jump height depend on contact stiffness?","seeds":[11,12,13],"study_id":"study.contact-stiffness-sensitivity","systems_under_test":[{"identifier":"sut.baseline-0","version":"1.0.0"}],"version":"1.0.0"}